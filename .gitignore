# ── CodeIgniter 4 (PHP) ──────────────────────────────────────
web/vendor/
vendor/

# Env files (never commit real credentials)
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example
ml/.env
ml/.env.*
!ml/.env.example

# Application runtime data
web/writable/cache/*
web/writable/logs/*
web/writable/session/*
!web/writable/session/index.html
web/writable/uploads/*
!web/writable/uploads/index.html
web/writable/debugbar/*
!web/writable/debugbar/index.html
web/writable/backups/
web/writable/*.sqlite
web/writable/*.sqlite-journal

# Test artifacts
tests/coverage*
phpunit
phpunit.xml
.phpunit.result.cache
.phpunit.cache/
build/
*.coverage

# ── Python & ML Microservice ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.coverage.*
coverage.xml
venv/
.venv/

# ── Large binary assets & ML weights ─────────────────────────
models/*.gguf
models/*.bin
ml/models/*.gguf
ml/models/*.bin
llama-bin/*.dll
llama-bin/*.dylib
ml/llama-bin/*.dll
ml/llama-bin/*.dylib

# ── Databases & Dumps (security risk) ────────────────────────
*.sql
*.sql.gz
*.dump
app_auth_tokens.sql

# ── Logs & Temp Files ────────────────────────────────────────
*.log
logs/
php_errors.log
*.tmp
*.temp

# ── Operating System Junk ────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
*~
*.swp
*.swo
.directory
.Trash-*

# ── IDE / Editors ────────────────────────────────────────────
.idea/
*.iml
nbproject/
nbbuild/
nbdist/
.nb-gradle/
*.sublime-workspace
*.sublime-project
